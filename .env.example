# ===== Gateway =====
API_KEYS=dev                           # comma-separated keys for /v1/*
SCHEDULER_URL=http://scheduler:7080
DISABLE_QOS=1                          # 1 = off (no QoS / rate-limit)
GATEWAY_PORT=7070

# ===== Scheduler =====
SCHEDULER_PORT=7080
MINER_URLS=http://miner1:6061,http://miner2:6062

# ===== Miners =====
MODEL_IMPL=onnx
MODEL_PATH=/app/services/miner/models/detector.onnx
IMAGENET_LABELS_PATH=/app/services/miner/models/imagenet_classes.txt
OMP_NUM_THREADS=1
ORT_NUM_THREADS=1

# ===== CORS (optional) =====
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST

# ===== Logging (optional) =====
LOG_LEVEL=info
